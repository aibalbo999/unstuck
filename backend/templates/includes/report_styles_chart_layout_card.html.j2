        .chart-card {
            min-width: 0;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
        }
        .chart-source { margin: 12px 0 0; font-size: 11px; line-height: 1.6; color: var(--text-muted); overflow-wrap: anywhere; }
        .chart-empty-state { display: grid; place-content: center; height: 100%; margin: 0; padding: 16px; color: var(--text-muted); text-align: center; font-size: 14px; line-height: 1.6; }
