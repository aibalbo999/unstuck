<section class="mode-focus mode-focus-event-swing" data-template-section="event-swing" aria-labelledby="mode-focus-title">
    <div class="mode-focus-header">
        <span class="mode-focus-kicker">MODE D · EVENT SWING</span>
        <h2 id="mode-focus-title">{{ mode_template.focus_heading }}</h2>
    </div>
    <p class="mode-focus-summary">{{ mode_template.core_question }}</p>
    <dl class="mode-focus-trade-grid">
        {% for row in mode_focus.rows %}
        <div><dt>{{ row.label }}</dt><dd>{{ row.value }}</dd></div>
        {% endfor %}
    </dl>
    <ul class="mode-focus-points">
        {% for point in mode_template.focus_points %}
        <li>{{ point }}</li>
        {% endfor %}
    </ul>
</section>
