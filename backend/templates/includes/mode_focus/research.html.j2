<section class="mode-focus mode-focus-research" data-template-section="research" aria-labelledby="mode-focus-title">
    <div class="mode-focus-header">
        <span class="mode-focus-kicker">MODE A · RESEARCH</span>
        <h2 id="mode-focus-title">{{ mode_template.focus_heading }}</h2>
    </div>
    <p class="mode-focus-summary">{{ mode_template.core_question }}</p>
    <dl class="mode-focus-research-grid">
        {% for row in mode_focus.rows %}
        <div><dt>{{ row.label }}</dt><dd>{{ row.value }}</dd></div>
        {% endfor %}
    </dl>
    <ol class="mode-focus-steps">
        {% for point in mode_template.focus_points %}
        <li>{{ point }}</li>
        {% endfor %}
    </ol>
</section>
