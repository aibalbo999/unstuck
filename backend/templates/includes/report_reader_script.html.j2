(() => {
    'use strict';
    const main = document.querySelector('main.main');
    if (!main || document.body.dataset.readerVersion === '1') return;
    const query = (selector, root = main) => root.querySelector(selector);
    const all = (selector, root = main) => Array.from(root.querySelectorAll(selector));
    const text = element => (element?.textContent || '').trim();
    const element = (tag, className, value) => {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (value !== undefined) node.textContent = value;
        return node;
    };
    const mode = main.dataset.reportLayout || ({
        mode_a_research: 'research', mode_b_trading: 'trading',
        mode_c_contrarian: 'contrarian', mode_d_event_swing: 'event-swing',
    })[main.dataset.reportTemplate] || 'research';
    let observations = {};
    try {
        const saved = JSON.parse(document.getElementById('report-reader-observations')?.textContent || '{}');
        if (saved && typeof saved === 'object' && !Array.isArray(saved)) observations = saved;
    } catch (_) { /* A damaged display receipt must not invent confirmed data. */ }
    const auditRows = all('.source-audit-table tbody tr').filter(row => query('.audit-status', row));
    const sourceObservations = Array.isArray(observations.source_audit) ? observations.source_audit.filter(row => row && typeof row === 'object').map((row, index) => row.label || observations.original_order !== true ? row : { ...row, label: text(query('td', auditRows[index] || document.createElement('tr'))) }) : [];
    const calendarReason = () => {
        const calendar = observations.event_calendar;
        if (!calendar || typeof calendar !== 'object' || !calendar.as_of_date) return '原保存資料未包含可判讀的事件日曆，須補抓後再評估事件影響';
        const base = /^\d{4}-\d{2}-\d{2}$/.test(calendar.as_of_date) ? calendar.as_of_date : '';
        if (!base) return '原日曆的觀測日期無法核對，不能代填事件日期';
        const end = new Date(base + 'T00:00:00Z');
        end.setUTCDate(end.getUTCDate() + 14);
        if (!Number.isFinite(end.getTime())) return '原日曆的觀測日期無法核對，不能代填事件日期';
        const horizon = end.toISOString().slice(0, 10);
        const events = (Array.isArray(calendar.events) ? calendar.events : []).filter(event => event && ['earnings_date', 'ex_dividend_date', 'dividend_pay_date'].includes(event.type) && /^\d{4}-\d{2}-\d{2}$/.test(event.date));
        const within = events.filter(event => (typeof event.end_date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(event.end_date) && event.end_date >= event.date ? event.end_date : event.date) >= base && event.date <= horizon);
        const next = events.filter(event => event.date > horizon).sort((a, b) => a.date.localeCompare(b.date))[0];
        const coverage = calendar.coverage_complete === true ? '' : '；來源未保證完整覆蓋，不代表沒有其他事件';
        if (within.length) return `日曆列有 ${within.slice(0, 3).map(event => event.date).join('、')} 的事件，但原分析尚未確認其影響與交易條件${coverage}`;
        if (calendar.calendar_fetch_status === 'success' || calendar.status === 'success') return next ? `日曆已取得，下一筆已列事件為 ${next.date}，不在原報告的 14 日範圍內${coverage}` : `日曆已取得，但未列出原報告 14 日範圍內可確認的事件${coverage}`;
        return `事件日曆未完整取得${calendar.calendar_error_kind ? '（' + calendar.calendar_error_kind + '）' : ''}，已有日期也不能視為完整覆蓋`;
    };
    const unfinishedMoat = all('.analysis-card').some(card => /護城河/.test(text(card)) && /待補推論步驟/.test(text(card)));
    const profiles = {
        research: ['A｜長線投資研究', '公司價值與長線判斷', '研究結論', ['最終建議', '基本情境估值', '整體護城河', '資料可信度']],
        trading: ['B｜交易與部位管理', '本次部位計畫', '本次部位動作', ['部位動作', '進場區間', '部位大小', '停損條件', '失效條件', '部位基準', '比例意義']],
        contrarian: ['C｜高估與下跌風險', '下跌風險與反向條件', '風險研究結論', ['空方結論', '做空觸發', '下行目標', '防軋空停損', '軋空風險', '論點失效']],
        'event-swing': ['D｜1–2 週短線觀察', '短線條件與關鍵價位', '短線研究方向', ['交易方向', '進場區間', '1-2 週目標', '嚴格停損', '支撐位', '壓力位', '事件催化', '重新評估條件', '波動風險']],
    };
    const profile = profiles[mode] || profiles.research;
    let decisionRows = new Map();
    const missing = value => /^(?:N\/?A|資料不足|未提供|未評估|尚未評估|未驗證|未估計|未確認|事件日期未確認|--)(?:\/10)?$/i.test(value.trim());
    const fieldLabel = node => {
        const parent = node.parentElement;
        const value = parent?.closest('dd,td,.vm-value,.metric-value,.trade-catalyst p');
        if (value?.matches('dd')) return text(value.previousElementSibling);
        if (value?.matches('.vm-value')) return text(value.previousElementSibling);
        if (value?.matches('td')) {
            const row = value.closest('tr');
            if (value.cellIndex > 0 && row?.cells.length === 2) return text(row.cells[0]);
            return text(value.closest('table')?.querySelectorAll('thead th')[value.cellIndex]);
        }
        if (value?.matches('.metric-value')) return text(query('.metric-label', value.parentElement));
        if (value?.matches('.trade-catalyst p')) return text(query('.trade-catalyst-label', value.parentElement));
        if (parent?.closest('.verdict-main')) return mode === 'event-swing' ? '交易方向' : '研究評級';
        // Markdown may split each field label and value across inline elements.
        for (const current of [node, parent]) {
            let previous = current?.previousSibling;
            while (previous?.nodeType === Node.TEXT_NODE && /^[\s：:]*$/.test(previous.textContent)) previous = previous.previousSibling;
            if (previous?.nodeType === Node.ELEMENT_NODE && previous.matches('strong,b')) return text(previous);
        }
        return text(parent?.closest('p,li')?.querySelector('strong'));
    };
    const shortObservation = () => /^(?:Neutral|中性(?:\s+Neutral)?|觀望（暫不建立新交易）)$/i.test(decisionRows.get('交易方向') || '');
    const fieldValue = (value, label = '') => {
        const key = label.replace(/[\s:：🛑]/g, '');
        if (value.trim() === '尚未提供（原報告未填此項，未記錄缺漏原因）') value = 'N/A';
        const direction = /^(?:交易方向|短線研究方向)$/.test(key);
        if (mode === 'event-swing' && direction && /^(?:Neutral|中性(?:\s+Neutral)?)$/i.test(value.trim())) return '觀望（暫不建立新交易）';
        if (/^(?:研究評級|最終建議|空方結論|建議|研究結論)$/.test(key) && /^(?:Neutral|中性(?:\s+Neutral)?)$/i.test(value.trim())) return '觀望（研究尚未形成明確買賣傾向）';
        if (/^資料不足[，：；（(]/.test(value.trim())) return value.replace('資料不足', '尚未確認');
        if (/^未提供[，：；（(]/.test(value.trim())) return value.replace('未提供', '尚未提供');
        if (/^(?:未評估|未驗證|未確認|未估計)[，：；（(]/.test(value.trim())) return value.replace(/未評估|未驗證|未確認|未估計/, '尚未確認');
        if (!missing(value)) return value;
        const price = /^(?:進場區間|進場價|1[-–]2週目標(?:價)?|目標價|嚴格停損|停損點|停損價|停損條件|每股來回成本|風險報酬)$/.test(key);
        if (mode === 'event-swing' && shortObservation() && /成本/.test(key)) return '不適用（觀望中，暫不估算新交易的執行成本）';
        if (mode === 'event-swing' && shortObservation() && price) return '不適用（觀望中，暫不設定交易價位）';
        if (mode === 'trading' && price && decisionRows.get('部位動作') === '等待') return '不適用（本次等待，暫不設定新交易條件）';
        if (mode === 'contrarian' && /^(?:下行目標|防軋空停損)$/.test(key) && /^(?:目前|本次|暫時)?(?:先)?(?:不建立空方部位|不進行放空|不做空)(?:[，。；、\s]|$)/.test(decisionRows.get('做空觸發') || '')) return '不適用（原計畫明示不建立空方部位）';
        if (/整體護城河|護城河評分/.test(key)) return unfinishedMoat ? '尚未確認（原分析的護城河推論仍有待補步驟，須重新分析；不能靠補股價直接填分）' : '尚未確認（原報告未提供可核實的護城河評分；缺值不等於零分）';
        if (/估值|基本情境|目標|支撐|壓力|停損|觸發|信心|風險/.test(key)) return '尚未確認（原報告未提供可核實的判斷或數值，不代填結論）';
        if (/事件|催化/.test(key)) return `尚未確認（${calendarReason()}）`;
        if (/成本/.test(key)) return '尚未提供（原報告未列出完整費率或交易成本估計，不以零代替）';
        if (/未評估|未驗證|未確認|未估計/.test(value)) return '尚未確認（原報告未完成此項核實，不能視為已確認結果）';
        return '尚未提供（原報告未填此項，未記錄缺漏原因）';
    };
    const narrativeFields = (value, field = '') => {
        // Only named fields, not market/technical uses of "neutral" or numbers.
        let result = value.replace(/(交易方向|短線研究方向|交易計畫)(\s*(?:為|是|[：:])\s*[「『“"']?)(Neutral|中性(?:\s+Neutral)?)(?=\s*(?:[」』”"'，,。；;！!？?\n]|$))/gi,
            (raw, label, separator, direction) => mode === 'event-swing' ? label + separator + fieldValue(direction, '交易方向') : raw);
        if (mode === 'event-swing') {
            const directionField = /^(?:交易方向|短線研究方向)/.test(field.trim());
            if (directionField) result = result.replace(/(目前方向\s*(?:為|是|[：:])\s*)(Neutral|中性(?:\s+Neutral)?)(?=\s*(?:[，,。；;（(]|$))/gi,
                (_, prefix, direction) => prefix + fieldValue(direction, '交易方向'));
            const returnToObservation = directionField ? /(回到\s*)(Neutral|中性(?:\s+Neutral)?)(?=\s*(?:[，,。；;（(]|$))/gi : /((?:結論(?:需)?|取消交易或)回到\s*)(Neutral|中性(?:\s+Neutral)?)(?=\s*(?:[，,。；;（(]|$))/gi;
            result = result.replace(returnToObservation, (_, prefix, direction) => prefix + fieldValue(direction, '交易方向'));
            if (shortObservation() && missing(decisionRows.get('進場區間') || '')) {
                if (result.trim() === '進場區間仍有效') result = result.replace('進場區間仍有效', '進場區間（觀望中，暫不設定）');
                result = result.replace(/只在\s*N\/?A\s*附近等待(?:觸發)?/gi, () => fieldValue('N/A', '進場區間'));
            }
        }
        result = result.replace(/(^|[，,。；;：:\n]\s*)(進場區間|進場價|1[-–]2\s*週目標(?:價)?|目標價|目標|嚴格停損|停損點|停損價|停損條件|停損|每股來回成本|風險報酬)(\s*(?:為|是|[：:])?\s*[「『“"']?)(尚未提供（原報告未填此項，未記錄缺漏原因）|N\/?A|資料不足|未提供|未評估|尚未評估|未驗證|未估計|未確認|--)(?=\s*(?:[」』”"'，,。；;！!？?\n]|（(?:即時|盤中\/收盤|每日收盤後|事件前後)）|$))/gi,
            (raw, boundary, label, separator, missingValue, offset, input) => {
                if (label === '目標' && (mode !== 'event-swing' || !/交易計畫|交易方向|進場區間|嚴格停損/.test(value))) return raw;
                const key = label === '目標' ? '目標價' : label === '停損' ? '停損價' : label;
                const following = input.slice(offset + raw.length).match(/^\s*([，,；;])\s*(.+)/);
                if (/^(?:資料不足|未提供|未評估|未驗證|未估計|未確認)$/.test(missingValue) && following && !/^(?:進場|目標|1[-–]2\s*週目標|嚴格停損|停損|每股來回成本|風險報酬)/.test(following[2])) {
                    const category = fieldValue(missingValue + '，', key).slice(0, -1);
                    return boundary + label + separator + category;
                }
                return boundary + label + separator + fieldValue(missingValue, key);
            });
        return result;
    };
    const labels = new Map([
        ['品質 gate 尚未記錄', '報告檢查紀錄不完整'], ['品質 gate 有警示', '報告有待確認事項'],
        ['品質 gate 未通過', '報告檢查未通過，暫勿採用結論'], ['品質 gate', '報告檢查'],
        ['輸出契約', '報告完整性與規則'], ['資料快照完整性', '保存資料完整性'],
        ['分析新鮮度', '結論是否跟上最新資料'], ['證據抽查', '分析依據核對'],
        ['資料快照', '報告保存資料'], ['來源審計', '資料來源與核對紀錄'],
        ['補充來源降級', '補充資料有缺口'], ['核心來源穩定度提醒', '主要資料來源穩定度需留意'],
        ['補充來源穩定度提醒', '補充資料來源穩定度需留意'],
        ['free_cash_flow_raw_non_positive', '估值使用的自由現金流小於或等於零，現行方法不適用'],
        ['no_executable_direction', '目前沒有明確可執行的交易方向'],
        ['紅軍與空頭反證', '可能推翻結論的風險'], ['法證財務', '財務異常檢查'],
        ['泡沫狙擊研究報告', '高估與下跌風險研究報告'], ['泡沫狙擊報告', '下跌風險綜合判斷'],
        ['泡沫狙擊結論', '下跌風險判斷'], ['核心催化劑', '原分析關注條件'],
        ['論點失效', '何時需要改變看法'], ['失效條件', '重新評估條件'],
        ['技術動能分析師', '股價走勢與買賣力道'], ['主力籌碼分析師', '法人與大戶動向'],
        ['波段交易決策者', '短線觀察計畫'], ['DCF 動態情境矩陣', '不同假設下的估值比較'],
        ['最大下行風險 (Key Downside Risks) / 空頭觀點', '可能下跌的主要原因'],
        ['Key Catalysts to Watch', '後續重要事件'], ['Add to Radar', '加入追蹤'],
        ['概覽總覽', '重點摘要'], ['Medium', '中'], ['medium', '中'], ['High', '高'], ['Low', '低'],
        ['中性 Neutral', '中性'], ['偏多 Long', '偏多'], ['偏空 Short', '偏空'],
        ['Neutral', '中性'], ['Long', '偏多'], ['Short', '偏空'],
        ['Technology', '科技業'], ['Electronic Components', '電子零組件'], ['Computer Hardware', '電腦硬體'],
        ['FinMind TaiwanStockInstitutionalInvestorsBuySell', 'FinMind 法人買賣超資料'],
        ['yfinance 5y history', 'Yahoo 股價歷史（yfinance，5 年）'],
        ['volatile', '波動不確定'], ['bullish', '偏多'], ['bearish', '偏空'],
        ['fresh', '資料仍在有效期間'], ['stale', '資料已過期'],
        ['MODE D · 1-2 WEEK HORIZON', '短線觀察｜1–2 週'],
    ]);
    const glossary = {
        TTM: '近十二個月', 'P/E': '本益比', 'P/B': '股價淨值比', ROE: '股東權益報酬率',
        DCF: '現金流折現估值', EPS: '每股盈餘', FCF: '自由現金流',
        WACC: '平均資金成本', RSI: '相對強弱指標', MACD: '趨勢動能指標',
        ATR: '平均價格波動幅度', Beta: '相對大盤波動程度', CapEx: '資本支出',
    };
    const compoundPlaceholder = value => value.replace(/(?<![\w/])N\/?A\s*(?:（([^（）()\n]+)）|\(([^（）()\n]+)\))/gi, (raw, wide, ascii) => {
        const savedReason = (wide || ascii).trim();
        const classified = savedReason.match(/^(不適用|來源異常|尚未提供|未提供|尚未確認|未確認|資料不足|未評估|未驗證|未估計)\s*[；;：:，,]\s*(.+)$/);
        // A schedule annotation such as N/A（即時） is not a recorded cause.
        if (!classified && savedReason !== '本次未重新估計') return raw;
        const prefix = classified?.[1];
        const category = prefix === '來源異常' ? '來源異常' : prefix === '不適用' ? '不適用' : /^(?:尚)?未提供$/.test(prefix || '') ? '尚未提供' : '尚未確認';
        return `${category}（${classified ? classified[2] : savedReason}）`;
    });
    const plain = (value, label = '') => {
        value = compoundPlaceholder(value);
        value = narrativeFields(value, label);
