    }
    for (const note of all('.report-reading-notice-note')) {
        if (note.closest('.report-reading-notice,.reader-original,.reader-audit')) continue;
        preserveCopy(note, '原驗證與使用限制說明');
        readable(note);
    }
    noticeAnchor?.after(brief);
    brief.after(limits);
    const metrics = query('.metrics-grid');
    if (metrics) { preserveCopy(metrics, '原主要數據'); readable(metrics, true); limits.after(metrics); }
    const trace = query('.execution-summary-card');
    if (trace) {
        for (const note of all('.execution-summary-note', trace)) addLimit('分析依據核對', text(note));
        moveToAudit(trace, '模型、執行流程與品質檢查原始紀錄');
    }
    for (const warning of all('.reference-official-warning')) addLimit('來源限制', text(warning));
    const trust = query('.data-trust-card');
    if (trust) {
        preserveCopy(trust, '原資料可信度與版本紀錄');
        const controls = query('.data-trust-controls', trust);
        if (controls) moveToAudit(controls, '資料檢查分數與版本資訊');
        readable(trust);
        limits.append(trust);
    }
    limits.append(element('p', 'reader-score-note', '資料新鮮不代表內容已完整核實；資料檢查分數與分析信心也不是上漲機率。'));
    if (focus) moveToAudit(focus, '原模式決策欄位');
    for (const node of all('.mode-template-card')) moveToAudit(node, '原模式與閱讀架構');
    for (const node of all('.section-model')) moveToAudit(node, '分析模組與模型');
    for (const node of all('.tear-sheet, .editor-synthesis')) {
        preserveCopy(node, '原整合摘要');
        readable(node, true);
        const disclosure = element('details', 'reader-original reader-expanded-summary');
        const heading = node.matches('.tear-sheet') ? '完整研究摘要' : text(query('.editor-synthesis-title', node)) || '投資假設與追蹤條件';
        disclosure.append(element('summary', '', heading), node);
        hero.append(disclosure);
    }
    for (const node of all('.analysis-card')) {
        const original = element('details', 'reader-original');
        original.append(element('summary', '', '原始分析與欄位引用'));
        const copy = node.cloneNode(true);
        copy.className = 'reader-analysis';
        all('[id]', copy).forEach(item => item.removeAttribute('id'));
        readable(copy, true);
        while (node.firstChild) original.append(node.firstChild);
        node.append(copy, original);
    }
    for (const node of all('.executive-thesis, .section-lead, .downside-list, .highlight-list, .data-table, .price-targets-grid, .final-verdict')) {
        if (node.closest('.reader-original,.reader-audit')) continue;
        preserveCopy(node);
        readable(node, true);
    }
    for (const node of all('.mode-focus-kicker,.hero-badge')) {
        if (!node.closest('.reader-audit')) node.textContent = profile[0];
    }
    for (const node of all('.section-title,.chart-title,.chart-source,.nav-label,.sidebar-catalysts,.sidebar-footer,.trade-setup,.trade-setup-dashboard', document)) {
        if (!node.closest('.reader-original,.reader-audit')) { preserveCopy(node); readable(node); }
    }
    for (const node of all('.references')) moveToAudit(node, '完整資料來源、供應商與取得紀錄');
    const chartNotes = {
        marketPriceChart: '價格與均線反映歷史走勢，不代表突破必然延續；還原價格與委託價格須分開核對。',
        institutionalDailyChart: '正值為買超、負值為賣超；觀察期間與單位以圖表標示為準。',
        institutionalCategoryChart: '各類法人可能方向不同，分類、期間及單位須一致才能比較。',
        revenueChart: '比較營收與獲利的變化；年度資料與近十二個月資料不可直接混為同一期。',
        marginChart: '利潤率顯示營收轉為獲利的比例，仍須搭配期間及產業特性。',
        fcfChart: '自由現金流反映現金收支；負值原因需核對投資支出與營運資金，不直接等於公司無價值。',
        roeChart: '股東權益報酬率須搭配負債與權益規模判讀。',
        valuationChart: '不同估值假設可能得出不同價格，圖中價位不是保證報酬。',
        peRiverChart: '歷史本益比區間僅供估值對照，不是未來價格必然回歸的範圍。',
        moatChart: '分析評分不是客觀機率；缺少證據或未評估項目不等於零分。',
    };
    for (const canvas of all('canvas')) {
        const card = canvas.closest('.chart-card');
        if (card && chartNotes[canvas.id]) card.append(element('p', 'reader-chart-note', chartNotes[canvas.id]));
    }
    // Repaint the saved charts for a light surface without changing series or axes.
    const chartPalette = {
        '#38bdf8': '#0369a1', '#f87171': '#a61b2b', '#34d399': '#166534',
        '#3b82f6': '#1d4ed8', '#10b981': '#166534', '#8b5cf6': '#6d28d9',
        '#f59e0b': '#854d0e', '#84cc16': '#3f6212', '#22c55e': '#166534',
        '#f97316': '#9a3412', '#ef4444': '#a61b2b', '#dc2626': '#a61b2b',
        '#64748b': '#52636e', '#94a3b8': '#52636e',
    };
    const chartColor = value => Array.isArray(value) ? value.map(chartColor)
        : typeof value === 'string' ? chartPalette[value.toLowerCase()] || value : value;
    if (typeof window.Chart?.getChart === 'function') {
        for (const canvas of all('canvas')) {
            const chart = window.Chart.getChart(canvas);
            if (!chart) continue;
            chart.options.color = '#52636e';
            const legend = chart.options.plugins?.legend;
            if (legend?.labels) legend.labels.color = '#52636e';
            const title = chart.options.plugins?.title;
            if (title) title.color = '#243431';
            for (const scale of Object.values(chart.options.scales || {})) {
                if (scale.ticks) scale.ticks.color = '#52636e';
                if (scale.grid) scale.grid.color = '#dce5e3';
                if (scale.angleLines) scale.angleLines.color = '#dce5e3';
                if (scale.pointLabels) scale.pointLabels.color = '#52636e';
            }
            for (const dataset of chart.data.datasets) {
                for (const key of ['borderColor', 'backgroundColor', 'pointBackgroundColor', 'pointBorderColor', 'hoverBackgroundColor', 'hoverBorderColor']) {
                    if (key in dataset) dataset[key] = chartColor(dataset[key]);
                }
            }
            chart.update('none');
        }
    }
    const sidebarRating = document.querySelector('.sidebar-rec');
    if (sidebarRating && verdict) sidebarRating.textContent = `${profile[2]}：${text(query('.verdict-main', verdict))}`;
    const navigation = document.querySelector('.sidebar .nav-section');
    if (navigation) {
        for (const [id, label] of [['reader-brief', '重點判讀'], ['reader-limits', '資料與風險限制'], ['reader-audit', '完整來源與查核']]) {
            const link = element('a', 'nav-item', label);
            link.href = `#${id}`;
            navigation.append(link);
        }
    }
    main.append(audit);
    document.addEventListener('click', event => {
        const link = event.target.closest?.('a[href^="#reader-"]');
        if (!link) return;
        const target = document.getElementById(link.getAttribute('href').slice(1));
        if (!target) return;
        let parent = target;
        while (parent) { if (parent.tagName === 'DETAILS') parent.open = true; parent = parent.parentElement; }
    });
    document.body.classList.add('reader-ready');
    document.body.dataset.readerVersion = '1';
})();
